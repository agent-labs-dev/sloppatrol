{
  "name": "sloppatrol",
  "version": "0.1.2",
  "description": "A team of AI agents that patrols your repo all day and makes the code cleaner, one verified, behaviour-preserving refactor at a time.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "sloppatrol": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "!dist/**/tests",
    "playbook",
    "ui",
    "LICENSE",
    "NOTICE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agent-labs-dev/sloppatrol.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check . && pnpm lint:boundaries && tsc --noEmit",
    "check:fix": "biome check --write .",
    "lint:boundaries": "depcruise src",
    "knip": "knip --no-config-hints",
    "prepare": "husky"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^22.7.5",
    "dependency-cruiser": "^17.0.0",
    "husky": "^9.1.7",
    "knip": "^6.38.0",
    "lint-staged": "^17.6.0",
    "typescript": "^5.6.3",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{ts,js,mjs,json}": "biome check --write --no-errors-on-unmatched"
  }
}
