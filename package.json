{
  "name": "sloppatrol",
  "version": "0.4.1",
  "description": "A team of AI agents that patrols your repo all day and makes the code cleaner, one verified, behaviour-preserving refactor at a time.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "sloppatrol": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "!dist/**/tests",
    "playbook",
    "ui",
    "LICENSE",
    "NOTICE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agent-labs-dev/sloppatrol.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check . && pnpm lint:boundaries && tsc --noEmit",
    "check:fix": "biome check --write .",
    "lint:boundaries": "depcruise src",
    "knip": "knip --no-config-hints",
    "gate": "pnpm check && pnpm knip && pnpm test",
    "gate:changed": "{ git diff -z --name-only --diff-filter=d \"$(git merge-base origin/main HEAD)\"; git ls-files -z --others --exclude-standard; } | xargs -0 -r biome check --no-errors-on-unmatched && pnpm lint:boundaries && tsc --noEmit && pnpm knip && vitest run --changed $(git merge-base origin/main HEAD)",
    "prepare": "husky"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "yaml": "^2.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^22.7.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "dependency-cruiser": "^18.7.2",
    "husky": "^9.1.7",
    "knip": "^6.45.1",
    "lint-staged": "^17.6.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*.{ts,js,mjs,json}": "biome check --write --no-errors-on-unmatched"
  }
}
